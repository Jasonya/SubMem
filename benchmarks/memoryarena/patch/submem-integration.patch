 @app.post("/memory/initialize")
 def initialize(req: InitializeRequest):
+    # MemoryArena runs tasks sequentially: a new initialize means the previous
+    # task's memory system is dead weight. Evict it so substrate-held GPU
+    # state (episodes, adapters) is freed; the HF backbone itself is a shared
+    # singleton inside the adapter and survives eviction.
+    if MEMORY_SYSTEMS:
+        # Evict finished same-name systems but KEEP the 2 most recent: with two
+        # concurrent shards of one substrate, each shard's active system is always
+        # among the newest 2, so only completed groups' state is freed. (Evicting
+        # every same-name entry here caused 404s on the sibling shard's active user.)
+        _name = req.memory_system_name
+        _same = [_uid for _uid, _e in MEMORY_SYSTEMS.items() if _e.name == _name]
+        for _uid in _same[:-2]:
+            _entry = MEMORY_SYSTEMS[_uid]
+            try:
+                _u = getattr(_entry.system, "_unit", None)
+                if _u is not None and hasattr(_u, "unload"):
+                    _u.unload()
+            except Exception:
+                pass
+            del MEMORY_SYSTEMS[_uid]
+        try:
+            import gc, torch
+            gc.collect()
+            torch.cuda.empty_cache()
+        except Exception:
+            pass
     name = req.memory_system_name
     if name in {"bm25", "text-embedding-3-small"}:
         memory_system = RAGMemorySystem(retrieval_method=name)
