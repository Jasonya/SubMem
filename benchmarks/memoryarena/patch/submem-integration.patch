+"""Memory-system registry.
+
+Imports are tolerant of missing optional dependencies (mirix, mem0, letta
+SDKs etc.) so that the memory server can run with whatever subset of
+systems is installed. Missing systems resolve to None and are skipped by
+the server's factory table.
+"""
+
+def _try(name, attr):
+    try:
+        mod = __import__(f"{__name__}.{name}", fromlist=[attr])
+        return getattr(mod, attr)
+    except Exception as e:  # noqa: BLE001 - report and continue
+        print(f"[memory_systems] {name} unavailable: {e}")
+        return None
+
+
+MirixMemorySystem = _try("mirix", "MirixMemorySystem")
+LongContextMemorySystem = _try("long_context", "LongContextMemorySystem")
+Mem0MemorySystem = _try("mem0", "Mem0MemorySystem")
+LettaMemorySystem = _try("letta", "LettaMemorySystem")
+RAGMemorySystem = _try("rag", "RAGMemorySystem")
+MemoRAGMemorySystem = _try("memorag", "MemoRAGMemorySystem")
+GraphRAGMemorySystem = _try("langchain_graphrag", "GraphRAGMemorySystem")
+AMemMemorySystem = _try("amem", "AMemMemorySystem")
+LightMemMemorySystem = _try("lightmem", "LightMemMemorySystem")
+ReasoningBankMemorySystem = _try("reasoningbank", "ReasoningBankMemorySystem")
+ZepMemorySystem = _try("zep", "ZepMemorySystem")
